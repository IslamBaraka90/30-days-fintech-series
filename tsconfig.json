  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "shared/**/*.ts",
    "day-01-*/src/**/*.ts",
    "day-02-*/src/**/*.ts"
  ]
}
