# --- Provider selection (Day 2+) ---
# Which provider to use: alpaca, finnhub, or fmp
MARKET_DATA_PROVIDER=alpaca
# Day 4: comma-separated list of providers to capture concurrently
MARKET_DATA_PROVIDERS=alpaca,finnhub,fmp

# --- Alpaca credentials (Day 1 & 2) ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# --- Finnhub credentials (Day 2) ---
FINNHUB_API_KEY=

# --- FMP credentials (Day 2, paid) ---
FMP_API_KEY=
FMP_WEBSOCKET_URL=
FMP_WEBSOCKET_AUTH=login

# --- Optional capture settings ---
# Symbol to capture (default: SPY)
SYMBOL=SPY
# Alpaca feed: iex, sip, or delayed_sip (default: iex)
ALPACA_FEED=iex
# Capture duration in seconds (default: 60, minimum: 10)
CAPTURE_SECONDS=60
# Day 1: max trades to capture (default: 10000)
MAX_TRADES=10000
# Day 2: max events to capture (default: 25000)
MAX_EVENTS=25000

# --- Day 1 bar settings ---
# Time bar interval in seconds (default: 10)
TIME_BAR_SECONDS=10

# --- Day 2 quality gate settings ---
# Quality bar interval in seconds (default: 10)
QUALITY_BAR_SECONDS=10
# Market session state: ACTIVE, INACTIVE, or HALTED
MARKET_SESSION_STATE=ACTIVE
# Whether market activity is expected (default: true)
ACTIVITY_EXPECTED=true
# Set to true only after verifying host/source clock synchronization
CLOCK_SYNC_VERIFIED=false

# --- Day 3 health check settings ---
# Maximum clock offset in ms (only meaningful when CLOCK_SYNC_VERIFIED=true)
CLOCK_MAX_OFFSET_MS=1
# Latency warning threshold in ms (default: 250)
LATENCY_WARNING_MS=250
# Latency critical threshold in ms (default: 1000)
LATENCY_CRITICAL_MS=1000

# --- Day 4 multi-source settings ---
# Maximum age in ms for a source observation to be eligible (default: 5000)
MAX_SOURCE_AGE_MS=5000
