{
  "name": "30-days-fintech-series",
  "version": "1.0.0",
  "description": "A tutorial following repo for the Fintech 30 Day series by TheFintechBuilder.com",
  "type": "module",
  "scripts": {
    "article:1": "node --env-file=.env --experimental-strip-types day-01-what-you-need-to-know-before-your-first-price-feed/src/build.ts",
    "article:2": "node --env-file=.env --experimental-strip-types day-02-your-price-feed-is-lying-to-you/src/build.ts",
    "demo:article:2": "node --experimental-strip-types day-02-your-price-feed-is-lying-to-you/src/demo.ts",
    "typecheck:article:1": "tsc --project day-01-what-you-need-to-know-before-your-first-price-feed/tsconfig.json",
    "typecheck:article:2": "tsc --project day-02-your-price-feed-is-lying-to-you/tsconfig.json",
    "test:article:1": "node --experimental-strip-types day-01-what-you-need-to-know-before-your-first-price-feed/src/bars.test.ts",
    "test:article:2": "node --experimental-strip-types day-02-your-price-feed-is-lying-to-you/src/quality.test.ts && node --experimental-strip-types day-02-your-price-feed-is-lying-to-you/src/provider-contract.test.ts",
    "article:3": "node --env-file=.env --experimental-strip-types day-03-is-my-feed-healthy-right-now/src/build.ts",
    "demo:article:3": "node --experimental-strip-types day-03-is-my-feed-healthy-right-now/src/demo.ts",
    "typecheck:article:3": "tsc --project day-03-is-my-feed-healthy-right-now/tsconfig.json",
    "test:article:3": "node --experimental-strip-types --test day-03-is-my-feed-healthy-right-now/src/health.test.ts",
    "article:4": "node --env-file=.env --experimental-strip-types day-04-multi-source-no-problem/src/build.ts",
    "demo:article:4": "node --experimental-strip-types day-04-multi-source-no-problem/src/demo.ts",
    "typecheck:article:4": "tsc --project day-04-multi-source-no-problem/tsconfig.json",
    "test:article:4": "node --experimental-strip-types --test day-04-multi-source-no-problem/src/synchronize.test.ts",
    "article:5": "node --env-file=.env --experimental-strip-types day-05-why-the-5-minute-candle-is-the-worst-way-to-sample/src/build.ts",
    "demo:article:5": "node --experimental-strip-types day-05-why-the-5-minute-candle-is-the-worst-way-to-sample/src/demo.ts",
    "typecheck:article:5": "tsc --project day-05-why-the-5-minute-candle-is-the-worst-way-to-sample/tsconfig.json",
    "test:article:5": "node --experimental-strip-types --test day-05-why-the-5-minute-candle-is-the-worst-way-to-sample/src/compare-bars.test.ts"
  },
  "keywords": [
    "FinTech",
    "Algorithms",
    "Data-feed"
  ],
  "author": "Islam Baraka",
  "license": "MIT",
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^4.0.1",
    "fintech-algorithms": "^0.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
